# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase → Project Settings → API Keys → Secret key (only on the server)
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# A unique private passphrase, at least 16 characters
ADMIN_PASSPHRASE=
# Generate with: node scripts/generate-secret.mjs
SESSION_SECRET=
# Optional display name
GROUP_NAME=Наша группа
